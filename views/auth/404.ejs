<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div class="min-h-screen overflow-hidden bg-white text-slate-900">
      <!-- Main Content -->
      <main
        class="mx-auto grid min-h-[75vh] max-w-7xl items-center gap-12 px-6 py-16 lg:grid-cols-2 lg:py-20"
      >
        <!-- Text -->
        <section>
          <span
            class="inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-600"
          >
            Error 404
          </span>

          <h1
            class="mt-6 text-5xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-6xl"
          >
            Page not
            <span class="text-blue-600">found.</span>
          </h1>

          <p
            class="mt-6 max-w-lg text-base leading-8 text-slate-500 sm:text-lg"
          >
            Oops! The page you're looking for doesn't exist, may have been
            moved, or is temporarily unavailable.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a
              href="/"
              class="inline-flex items-center gap-3 rounded-xl bg-blue-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:-translate-y-0.5 hover:bg-blue-700"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                class="h-5 w-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="m15 18-6-6 6-6 M9 12h12"
                />
              </svg>
              Go Back Home
            </a>

            <button
              type="button"
              onclick="history.back()"
              class="rounded-xl border border-slate-200 px-6 py-3.5 font-semibold text-slate-600 transition hover:bg-slate-50"
            >
              Go Back
            </button>
          </div>

          <p class="mt-8 text-sm text-slate-400">
            Need help? Return to the homepage and try again.
          </p>
        </section>

        <!-- Illustration -->
        <section class="relative flex items-center justify-center">
          <div
            class="absolute h-72 w-72 rounded-full bg-blue-50 sm:h-96 sm:w-96"
          ></div>

          <div class="relative flex flex-col items-center">
            <div
              class="flex h-48 w-48 items-center justify-center rounded-[2.5rem] bg-white shadow-xl shadow-blue-100 ring-1 ring-slate-100 sm:h-60 sm:w-60"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 200 200"
                class="h-36 w-36 sm:h-48 sm:w-48"
              >
                <circle cx="100" cy="100" r="82" fill="#EFF6FF" />
                <path
                  d="M61 49h53l27 27v74H61V49Z"
                  fill="white"
                  stroke="#93C5FD"
                  stroke-width="4"
                  stroke-linejoin="round"
                />
                <path
                  d="M114 49v28h27"
                  stroke="#93C5FD"
                  stroke-width="4"
                  stroke-linejoin="round"
                />
                <path
                  d="M78 102h45M78 117h32"
                  stroke="#BFDBFE"
                  stroke-width="5"
                  stroke-linecap="round"
                />
                <text
                  x="99"
                  y="145"
                  text-anchor="middle"
                  font-size="30"
                  font-weight="800"
                  fill="#2563EB"
                >
                  404
                </text>
                <circle cx="145" cy="48" r="20" fill="#2563EB" />
                <text
                  x="145"
                  y="56"
                  text-anchor="middle"
                  font-size="25"
                  font-weight="700"
                  fill="white"
                >
                  ?
                </text>
              </svg>
            </div>

            <div class="mt-8 text-center">
              <p class="text-lg font-bold text-slate-800">
                Looks like you're lost
              </p>
              <p class="mt-2 text-sm text-slate-500">
                Let's get you back on track.
              </p>
            </div>
          </div>
        </section>
      </main>

      <!-- Footer -->
      <footer class="border-t border-slate-100">
        <div
          class="mx-auto max-w-7xl px-6 py-6 text-center text-sm text-slate-400"
        >
          © <%= new Date().getFullYear() %> College CMS. All rights reserved.
        </div>
      </footer>
    </div>
  </body>
</html>
