<header
  class="flex h-20 items-center justify-between border-b border-slate-200 bg-white px-8"
>
  <h1 class="text-2xl font-semibold text-slate-800">
    <%= title || "College CMS" %>
  </h1>

  <div class="flex items-center gap-5">
    <% if (user && user.name) { %>
    <div class="flex items-center gap-3">
      <div>
        <p class="text-[17px] font-bold text-slate-800">
          <%= user.name.charAt(0).toUpperCase() +
          user.name.slice(1).toLowerCase() %>!
        </p>
        <p class="text-[14px] text-slate-500"><%= user.role || "Student" %></p>
      </div>
    </div>
    <% } else { %>
    <div class="flex items-center gap-3">
      <a
        href="/login"
        class="text-sm font-medium text-slate-600 hover:text-blue-600"
      >
        Login
      </a>
      <a
        href="/register"
        class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
      >
        Register
      </a>
    </div>
    <% } %>
  </div>
</header>
