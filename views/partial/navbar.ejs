<header
  class="flex h-20 items-center justify-between border-b border-slate-200 bg-white px-8"
>
  <h1 class="text-2xl font-semibold text-slate-800"><%= title %></h1>

  <div class="flex items-center gap-5">
    <!-- Notification -->
    <button class="text-xl text-slate-600 hover:text-blue-600">♧</button>

    <!-- Student Profile -->
    <div class="flex items-center gap-3">
      <div>
        <p class="text-[17px] font-bold text-slate-800">
          <%= user.name.charAt(0).toUpperCase() +
          user.name.slice(1).toLowerCase() %>!
        </p>
        <p class="text-[14px] text-slate-500"><%= user.role %></p>
      </div>
    </div>
  </div>
</header>
