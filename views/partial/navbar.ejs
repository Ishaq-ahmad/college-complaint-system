<header
  class="flex min-h-16 flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:min-h-20 sm:px-6 lg:px-8"
>
  <h1
    class="min-w-0 break-words text-lg font-semibold text-slate-800 sm:text-xl lg:text-2xl"
  >
    <%= title || "College CMS" %>
  </h1>

  <div class="flex items-center gap-3 sm:gap-5">
    <% if (user && user.name) { %>
    <div class="flex min-w-0 items-center gap-3">
      <div class="min-w-0">
        <p class="break-words text-sm font-bold text-slate-800 sm:text-base">
          <%= user.name.charAt(0).toUpperCase() +
          user.name.slice(1).toLowerCase() %>!
        </p>
        <p class="text-xs capitalize text-slate-500 sm:text-sm">
          <%= user.role || "Student" %>
        </p>
      </div>
    </div>
    <% } else { %>
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <a
        href="/login"
        class="text-sm font-medium text-slate-600 transition hover:text-blue-600"
      >
        Login
      </a>
      <a
        href="/register"
        class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-blue-700 sm:px-4"
      >
        Register
      </a>
    </div>
    <% } %>
  </div>
</header>
