<!-- Dashboard Content -->
<section class="min-h-screen bg-slate-50 px-4 py-6 sm:px-6 lg:px-8">
  <!-- Welcome Section -->
  <div class="mb-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p
          class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-blue-600"
        >
          Student Portal
        </p>

        <h2
          class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl"
        >
          Welcome back, <%= user.name .trim() .toLowerCase() .replace(/\b\w/g,
          char => char.toUpperCase()) %>!
        </h2>

        <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">
          Keep track of your complaints and stay updated on their progress.
        </p>
      </div>

      <a
        href="/new-complaint"
        class="inline-flex w-fit items-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-800"
      >
        <span class="text-lg leading-none">+</span>
        New Complaint
      </a>
    </div>
  </div>

  <!-- Statistics -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Total Complaints -->
    <div
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">Total Complaints</p>

          <h3 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">
            <%= total_complaints %>
          </h3>
        </div>

        <div
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 10h8M8 14h5m7-2a8 8 0 11-16 0 8 8 0 0116 0z"
            />
          </svg>
        </div>
      </div>

      <div class="mt-5 h-1 w-10 rounded-full bg-blue-500"></div>
    </div>

    <!-- Pending -->
    <div
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">Pending</p>

          <h3 class="mt-3 text-3xl font-semibold tracking-tight text-amber-600">
            <%= complaints.filter(item => item.status === 'Pending').length %>
          </h3>
        </div>

        <div
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>
      </div>

      <div class="mt-5 h-1 w-10 rounded-full bg-amber-400"></div>
    </div>

    <!-- Rejected -->
    <div
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">Rejected</p>

          <h3 class="mt-3 text-3xl font-semibold tracking-tight text-red-600">
            <%= complaints.filter(item => item.status === 'Rejected').length %>
          </h3>
        </div>

        <div
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-red-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </div>
      </div>

      <div class="mt-5 h-1 w-10 rounded-full bg-red-500"></div>
    </div>

    <!-- Resolved -->
    <div
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">Resolved</p>

          <h3
            class="mt-3 text-3xl font-semibold tracking-tight text-emerald-600"
          >
            <%= complaints.filter(item => item.status === 'Resolved').length %>
          </h3>
        </div>

        <div
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"
            />
          </svg>
        </div>
      </div>

      <div class="mt-5 h-1 w-10 rounded-full bg-emerald-500"></div>
    </div>
  </div>

  <!-- Recent Complaints -->
  <div
    class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
  >
    <!-- Section Header -->
    <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Recent Complaints
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Your latest submitted complaints and their current status.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/complaints"
            class="rounded-lg border border-slate-200 px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50"
          >
            View All
          </a>

          <a
            href="/new-complaint"
            class="rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700"
          >
            New Complaint
          </a>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="w-full min-w-[800px] text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50/70">
          <tr class="text-xs uppercase tracking-wide text-slate-500">
            <th class="px-6 py-3.5 font-semibold">#</th>

            <th class="px-6 py-3.5 font-semibold">Title</th>

            <th class="px-6 py-3.5 font-semibold">Category</th>

            <th class="px-6 py-3.5 font-semibold">Status</th>

            <th class="px-6 py-3.5 font-semibold">Date</th>

            <th class="px-6 py-3.5 text-right font-semibold">Action</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100 text-slate-700">
          <% complaints.forEach((compl, index) => { %>

          <tr class="transition hover:bg-slate-50/80">
            <!-- Number -->
            <td class="px-6 py-4 text-sm font-medium text-slate-400">
              <%= index + 1 %>
            </td>

            <!-- Title -->
            <td class="max-w-[260px] px-6 py-4">
              <p class="truncate font-medium text-slate-800">
                <%= compl.title .trim() .toLowerCase() .replace(/\b\w/g, char =>
                char.toUpperCase()) %>!
              </p>
            </td>

            <!-- Category -->
            <td class="px-6 py-4 text-slate-500"><%= compl.category %></td>

            <!-- Status -->
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= compl.status === 'Pending' ? 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200' : compl.status === 'Rejected' ? 'bg-red-300 text-red-700 ring-1 ring-inset ring-red-200' : compl.status === 'Resolved' ? 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200' : 'bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-200' %>"
              >
                <span
                  class="h-1.5 w-1.5 rounded-full <%= compl.status === 'Pending' ? 'bg-amber-500' : compl.status === 'Rejected' ? 'bg-red-500' : compl.status === 'Resolved' ? 'bg-emerald-500' : 'bg-slate-400' %>"
                ></span>

                <%= compl.status %>
              </span>
            </td>

            <!-- Date -->
            <td class="whitespace-nowrap px-6 py-4 text-slate-500">
              <%= new Date(compl.createdAt).toLocaleDateString("en-GB") %>
            </td>

            <!-- Action -->
            <td class="px-6 py-4 text-right">
              <a
                href="/complaints/<%= compl._id %>"
                class="inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-sm font-medium text-blue-600 transition hover:bg-blue-50 hover:text-blue-700"
              >
                View

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </td>
          </tr>

          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>
