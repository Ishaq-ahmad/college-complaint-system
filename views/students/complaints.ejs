<!-- Header -->
<header
  class="flex min-h-20 flex-col gap-4 border-b border-slate-200 bg-white px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
>
  <div>
    <p
      class="mb-1 text-xs font-semibold uppercase tracking-[0.15em] text-blue-600"
    >
      <%= user.role.trim().toUpperCase() %> Portal
    </p>

    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
      My Complaints
    </h1>
  </div>

  <a
    href="/new-complaint"
    class="inline-flex w-fit items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
  >
    <span class="text-lg leading-none">+</span>
    New Complaint
  </a>
</header>

<!-- Main Content -->
<section class="min-h-[calc(100vh-80px)] bg-slate-50 px-5 py-7 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <!-- Page Heading -->
    <div class="mb-6">
      <h2 class="text-xl font-semibold tracking-tight text-slate-900">
        All Complaints
      </h2>

      <p class="mt-1.5 text-sm text-slate-500">
        Track and manage your submitted complaints.
      </p>
    </div>

    <!-- Complaints Table -->
    <div
      class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Table Top -->
      <div
        class="flex flex-col gap-2 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <div>
          <h3 class="text-sm font-semibold text-slate-800">
            Complaint History
          </h3>

          <p class="mt-0.5 text-xs text-slate-400">
            Your previously submitted complaints
          </p>
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50/70">
            <tr class="text-xs uppercase tracking-wide text-slate-500">
              <th class="px-6 py-3.5 font-semibold">#</th>

              <th class="px-6 py-3.5 font-semibold">Title</th>

              <th class="px-6 py-3.5 font-semibold">Category</th>

              <th class="px-6 py-3.5 font-semibold">Status</th>

              <th class="px-6 py-3.5 font-semibold">Date</th>

              <th class="px-6 py-3.5 text-right font-semibold">Action</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 text-slate-700">
            <!-- Complaint 1 -->

            <% complaints.map((compl) => { %>

            <tr class="transition hover:bg-slate-50/80">
              <td class="px-6 py-4 text-sm font-medium text-slate-400">1</td>

              <td class="max-w-[280px] px-6 py-4">
                <p class="truncate font-medium text-slate-800">
                  <%= compl.title.trim().toLowerCase().replace(/\b\w/g, char =>
                  char.toUpperCase()) %>!
                </p>
              </td>

              <td class="px-6 py-4 text-slate-500"><%= compl.category %></td>

              <td class="px-6 py-4">
                <span
                  class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200 <%= compl.status === 'Pending' ? 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200' : compl.status === 'Rejected' ? 'bg-red-300 text-red-700 ring-1 ring-inset ring-red-200' : compl.status === 'Resolved' ? 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200' : 'bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-200' %>"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                  <%= compl.status %>
                </span>
              </td>

              <td class="whitespace-nowrap px-6 py-4 text-slate-500">
                <%= new Date(compl.createdAt).toLocaleDateString("en-GB") %>
              </td>

              <td class="px-6 py-4 text-right">
                <a
                  href="/complaints/<%= compl.id %>"
                  class="inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 text-sm font-medium text-blue-600 transition hover:bg-blue-50 hover:text-blue-700"
                >
                  View

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </td>
            </tr>

            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
