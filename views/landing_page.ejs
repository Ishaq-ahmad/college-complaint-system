<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>College CMS | Complaint Management System</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Inter", sans-serif;
      }

      html {
        scroll-behavior: smooth;
      }

      .hero-image {
        background: linear-gradient(
          to bottom,
          rgba(15, 23, 42, 0.02),
          rgba(15, 23, 42, 0.2)
        );
      }
    </style>
  </head>

  <body class="bg-slate-50 text-slate-800">
    <!-- NAVBAR -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-10">
      <nav
        class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3">
          <div
            class="w-10 h-10 bg-blue-900 rounded-lg flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3L3 8l9 5 9-5-9-5z
                                 M5 10v6l7 4 7-4v-6
                                 M12 13v7"
              />
            </svg>
          </div>

          <div>
            <h1 class="text-xl font-bold text-blue-950">College CMS</h1>

            <p class="text-xs text-slate-500">Complaint Management</p>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <div
          class="hidden md:flex items-center gap-9 text-sm font-medium text-slate-600"
        >
          <a href="/" class="text-blue-900 hover:text-blue-700"> Home </a>

          <a href="/dashboard" class="hover:text-blue-900 transition">
            Dashboard
          </a>

          <a href="#contact" class="hover:text-blue-900 transition">
            Contact
          </a>

          <a
            href="/login"
            class="bg-blue-900 text-white px-6 py-2.5 rounded-md hover:bg-blue-800 transition"
          >
            Login
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
          id="menuBtn"
          class="md:hidden text-slate-700"
          aria-label="Open navigation menu"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-width="2"
              stroke-linecap="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </nav>

      <!-- Mobile Navigation -->
      <div
        id="mobileMenu"
        class="hidden md:hidden px-6 pb-5 space-y-4 text-sm font-medium text-slate-600"
      >
        <a href="/" class="block">Home</a>

        <a href="#about" class="block">About</a>

        <a href="#contact" class="block">Contact</a>

        <a
          href="/login"
          class="inline-block bg-blue-900 text-white px-5 py-2 rounded-md"
        >
          Login
        </a>
      </div>
    </header>

    <!-- HERO SECTION -->
    <main>
      <section class="max-w-7xl mx-auto px-6 lg:px-10 pt-16 pb-20">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <!-- Hero Content -->
          <div class="max-w-xl">
            <div
              class="inline-flex items-center gap-2 bg-blue-50 text-blue-900 px-3 py-1.5 rounded-full text-xs font-semibold mb-6"
            >
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>

              A better way to raise concerns
            </div>

            <h2
              class="text-4xl md:text-5xl font-bold text-slate-900 leading-tight tracking-tight"
            >
              Welcome to

              <span class="block text-blue-900"> College Complaint </span>

              <span class="block"> Management System </span>
            </h2>

            <p class="mt-6 text-slate-600 leading-7 text-base max-w-lg">
              Have an issue? We're here to help. Submit your complaints, track
              their progress and get updates, all in one place.
            </p>

            <!-- Login Buttons -->
            <div class="flex flex-wrap gap-4 mt-8">
              <a
                href="/register"
                class="inline-flex items-center gap-2 bg-blue-900 text-white px-6 py-3 rounded-md text-sm font-semibold hover:bg-blue-800 transition shadow-sm"
              >
                Register

                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 12h14m-7-7l7 7-7 7"
                  />
                </svg>
              </a>

              <a
                href="/login"
                class="inline-flex items-center border border-slate-300 bg-white text-slate-700 px-6 py-3 rounded-md text-sm font-semibold hover:bg-slate-100 transition"
              >
                Login
              </a>
            </div>

            <div class="flex items-center gap-3 mt-8 text-sm text-slate-500">
              <div class="flex -space-x-2">
                <div
                  class="w-8 h-8 rounded-full bg-blue-100 border-2 border-white flex items-center justify-center text-xs font-bold text-blue-900"
                >
                  S
                </div>

                <div
                  class="w-8 h-8 rounded-full bg-green-100 border-2 border-white flex items-center justify-center text-xs font-bold text-green-900"
                >
                  A
                </div>

                <div
                  class="w-8 h-8 rounded-full bg-orange-100 border-2 border-white flex items-center justify-center text-xs font-bold text-orange-900"
                >
                  C
                </div>
              </div>

              <span> Simple, transparent and accessible </span>
            </div>
          </div>

          <!-- Hero Image -->
          <div class="relative">
            <div
              class="absolute inset-8 bg-blue-100 rounded-full blur-3xl opacity-60"
            ></div>

            <div
              class="relative bg-white border border-slate-200 rounded-2xl shadow-sm p-4 md:p-6"
            >
              <!-- Image Header -->
              <div class="flex justify-between items-center mb-5">
                <div>
                  <p class="text-xs text-slate-400 uppercase tracking-wider">
                    Campus
                  </p>

                  <h3 class="font-semibold text-slate-800">Our College</h3>
                </div>

                <span
                  class="flex items-center gap-2 text-xs text-green-700 bg-green-50 px-3 py-1.5 rounded-full"
                >
                  <span class="w-2 h-2 bg-green-500 rounded-full"></span>

                  Online
                </span>
              </div>

              <!-- Unsplash Image -->
              <div class="relative overflow-hidden rounded-xl h-64 sm:h-80">
                <img
                  src="https://images.unsplash.com/photo-1498243691581-b145c3f54a5a?auto=format&fit=crop&w=1200&q=85"
                  alt="University library and campus"
                  class="w-full h-full object-cover"
                />

                <div
                  class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"
                ></div>

                <div class="absolute bottom-5 left-5 text-white">
                  <p class="text-xs uppercase tracking-wider text-blue-100">
                    Your campus
                  </p>

                  <h3 class="text-xl font-semibold mt-1">
                    A better campus experience
                  </h3>
                </div>
              </div>

              <!-- Image Footer -->
              <div class="mt-5 flex items-center justify-between">
                <div>
                  <p class="text-sm font-semibold text-slate-800">
                    Your concerns matter
                  </p>

                  <p class="text-xs text-slate-500 mt-1">
                    We're here to make things easier.
                  </p>
                </div>

                <div
                  class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-900"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FEATURES SECTION -->
      <section id="about" class="bg-white border-y border-slate-100">
        <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16">
          <div class="text-center mb-10">
            <p
              class="text-sm font-semibold text-blue-800 uppercase tracking-wider"
            >
              Our Services
            </p>

            <h2 class="text-3xl font-bold text-slate-900 mt-3">
              Everything in one place
            </h2>

            <p class="text-slate-500 mt-3 max-w-xl mx-auto text-sm leading-6">
              From submitting a complaint to checking its status, manage your
              concerns without unnecessary hassle.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Feature 1 -->
            <div
              class="border border-slate-200 rounded-xl p-6 hover:border-blue-300 hover:shadow-md transition"
            >
              <div
                class="w-12 h-12 rounded-lg bg-indigo-50 flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-indigo-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 5H6a2 2 0 00-2 2v12
                                         a2 2 0 002 2h12
                                         a2 2 0 002-2V7
                                         a2 2 0 00-2-2h-2
                                         M9 3h6v4H9z
                                         M8 12h8M8 16h5"
                  />
                </svg>
              </div>

              <h3 class="font-semibold text-lg mt-5 text-slate-900">
                Easy Complaint
              </h3>

              <p class="text-sm text-slate-500 leading-6 mt-2">
                Submit your complaints online in just a few simple steps.
              </p>
            </div>

            <!-- Feature 2 -->
            <div
              class="border border-slate-200 rounded-xl p-6 hover:border-blue-300 hover:shadow-md transition"
            >
              <div
                class="w-12 h-12 rounded-lg bg-amber-50 flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-amber-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4l3 2m6-2
                                         a9 9 0 11-18 0
                                         9 9 0 0118 0z"
                  />
                </svg>
              </div>

              <h3 class="font-semibold text-lg mt-5 text-slate-900">
                Track Status
              </h3>

              <p class="text-sm text-slate-500 leading-6 mt-2">
                Check the latest status of your submitted complaints.
              </p>
            </div>

            <!-- Feature 3 -->
            <div
              class="border border-slate-200 rounded-xl p-6 hover:border-blue-300 hover:shadow-md transition"
            >
              <div
                class="w-12 h-12 rounded-lg bg-green-50 flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4
                                         m5-2l-8-4-8 4v6
                                         c0 5 8 8 8 8s8-3
                                         8-8V8z"
                  />
                </svg>
              </div>

              <h3 class="font-semibold text-lg mt-5 text-slate-900">
                Quick Resolution
              </h3>

              <p class="text-sm text-slate-500 leading-6 mt-2">
                Keep track of complaints and receive updates on their
                resolution.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CAMPUS IMAGE SECTION -->
      <section class="max-w-7xl mx-auto px-6 lg:px-10 py-16">
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="overflow-hidden rounded-xl h-72 md:h-80">
            <img
              src="https://images.unsplash.com/photo-1555010655-cfd83fec0fd8?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTA5fHxjb21wbGFpbnQtcHJvamVjdCUyMGJnJTIwaW1hZ2V8ZW58MHx8MHx8fDA%3D"
              alt="College students on campus"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>

          <div>
            <p
              class="text-sm font-semibold text-blue-800 uppercase tracking-wider"
            >
              About Our System
            </p>

            <h2 class="text-3xl font-bold text-slate-900 mt-3">
              Making campus life easier
            </h2>

            <p class="text-slate-600 leading-7 text-sm mt-5">
              Our College Complaint Management System provides students with a
              simple way to report issues and follow their progress. The system
              also helps administrators review complaints and manage resolutions
              efficiently.
            </p>

            <a
              href="/login"
              class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-blue-900 hover:text-blue-700"
            >
              Get Started

              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 12h14m-7-7l7 7-7 7"
                />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section id="contact" class="max-w-7xl mx-auto px-6 lg:px-10 pb-16">
        <div
          class="bg-blue-950 rounded-2xl px-8 py-10 md:px-12 flex flex-col md:flex-row justify-between items-center gap-6"
        >
          <div>
            <h2 class="text-2xl font-bold text-white">Have a concern?</h2>

            <p class="text-blue-200 text-sm mt-2">
              Log in to submit and manage your complaints.
            </p>
          </div>

          <a
            href="/login"
            class="bg-white text-blue-950 px-6 py-3 rounded-md font-semibold text-sm hover:bg-blue-50 transition whitespace-nowrap"
          >
            Get Started
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-slate-200">
      <div
        class="max-w-7xl mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row justify-between items-center gap-3"
      >
        <p class="text-sm text-slate-500">
          © 2026 College CMS. All rights reserved.
        </p>

        <p class="text-sm text-slate-500">
          Built for a better campus experience.
        </p>
      </div>
    </footer>

    <!-- MOBILE MENU SCRIPT -->
    <script>
      const menuBtn = document.getElementById("menuBtn");
      const mobileMenu = document.getElementById("mobileMenu");

      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });
    </script>
  </body>
</html>
