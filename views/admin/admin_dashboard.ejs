<!-- Dashboard Content -->
<section class="min-h-screen bg-slate-50 px-3 py-5 sm:px-6 sm:py-7 lg:px-8">
  <div class="mx-auto w-full max-w-7xl min-w-0">
    <!-- Page Heading -->
    <div class="mb-6 sm:mb-7">
      <p
        class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-blue-600"
      >
        Administration
      </p>

      <div
        class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
      >
        <div class="min-w-0">
          <h2
            class="text-xl font-semibold tracking-tight text-slate-900 sm:text-2xl"
          >
            All Complaints
          </h2>
          <p class="mt-1.5 max-w-xl text-sm leading-6 text-slate-500">
            View and manage complaints submitted by students.
          </p>
        </div>
      </div>
    </div>

    <!-- Statistics -->
    <div
      class="mb-6 grid grid-cols-1 gap-3 sm:mb-8 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4"
    >
      <!-- Total Complaints -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-500">Total Complaints</p>
            <h3
              class="mt-3 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl"
            >
              <%= total_complaints %>
            </h3>
          </div>
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 10h8M8 14h5m7-2a8 8 0 11-16 0 8 8 0 0116 0z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-5 h-1 w-10 rounded-full bg-blue-500"></div>
      </div>

      <!-- Pending -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-500">Pending</p>
            <h3
              class="mt-3 text-2xl font-semibold tracking-tight text-amber-600 sm:text-3xl"
            >
              <%= complaints.filter(item => item.status === 'Pending').length %>
            </h3>
          </div>
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-5 h-1 w-10 rounded-full bg-amber-400"></div>
      </div>

      <!-- Resolved -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-500">Resolved</p>
            <h3
              class="mt-3 text-2xl font-semibold tracking-tight text-green-600 sm:text-3xl"
            >
              <%= complaints.filter(item => item.status === 'Resolved').length
              %>
            </h3>
          </div>
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-50 text-green-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-5 h-1 w-10 rounded-full bg-green-400"></div>
      </div>

      <!-- Rejected -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-500">Rejected</p>
            <h3
              class="mt-3 text-2xl font-semibold tracking-tight text-red-600 sm:text-3xl"
            >
              <%= complaints.filter(item => item.status === 'Rejected').length
              %>
            </h3>
          </div>
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>
        <div class="mt-5 h-1 w-10 rounded-full bg-red-400"></div>
      </div>
    </div>

    <!-- Complaints Table -->
    <div
      class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Table Header -->
      <div class="border-b border-slate-200 px-4 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-semibold text-slate-900">
          Student Complaints
        </h3>
        <p class="mt-1 text-sm leading-5 text-slate-500">
          Review submitted complaints and update their status.
        </p>
      </div>

      <!-- Horizontally Scrollable Table -->
      <div class="w-full overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50/70">
            <tr class="text-xs uppercase tracking-wide text-slate-500">
              <th class="whitespace-nowrap px-4 py-3.5 font-semibold sm:px-5">
                #
              </th>
              <th class="px-4 py-3.5 font-semibold sm:px-5">Title</th>
              <th class="px-4 py-3.5 font-semibold sm:px-5">Student</th>
              <th class="px-4 py-3.5 font-semibold sm:px-5">Category</th>
              <th class="px-4 py-3.5 font-semibold sm:px-5">Status</th>
              <th class="whitespace-nowrap px-4 py-3.5 font-semibold sm:px-5">
                Date
              </th>
              <th
                class="whitespace-nowrap px-4 py-3.5 text-right font-semibold sm:px-5"
              >
                Action
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 text-slate-700">
            <% complaints.forEach((complaint, index) => { %>
            <tr class="transition hover:bg-slate-50/80">
              <!-- Number -->
              <td
                class="whitespace-nowrap px-4 py-4 font-medium text-slate-400 sm:px-5"
              >
                <%= index + 1 %>
              </td>

              <!-- Title -->
              <td class="max-w-[220px] px-4 py-4 sm:px-5">
                <p class="truncate font-medium text-slate-800">
                  <%= complaint.title.toUpperCase() %>
                </p>
              </td>

              <!-- Student -->
              <td class="px-4 py-4 sm:px-5">
                <div class="flex items-center gap-2.5">
                  <div
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600"
                  >
                    <%= complaint.student.name.toUpperCase().charAt(0) %>
                  </div>
                  <span class="whitespace-nowrap text-slate-700">
                    <%=
                    complaint.student.name.trim().toLowerCase().replace(/\b\w/g,
                    char => char.toUpperCase()) %>
                  </span>
                </div>
              </td>

              <!-- Category -->
              <td class="whitespace-nowrap px-4 py-4 text-slate-500 sm:px-5">
                <%= complaint.category %>
              </td>

              <!-- Status -->
              <td class="px-4 py-4 sm:px-5">
                <span
                  class="inline-flex whitespace-nowrap items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= complaint.status === 'Pending' ? 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200' : complaint.status === 'Rejected' ? 'bg-red-200 text-red-700 ring-1 ring-inset ring-violet-200' : 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200' %>"
                >
                  <span class="h-1.5 w-1.5 rounded-full"></span>
                  <%= complaint.status %>
                </span>
              </td>

              <!-- Date -->
              <td class="whitespace-nowrap px-4 py-4 text-slate-500 sm:px-5">
                <%= new Date(complaint.createdAt).toLocaleDateString("en-GB") %>
              </td>

              <!-- Action -->
              <td class="whitespace-nowrap px-4 py-4 text-right sm:px-5">
                <a
                  href="/admin/complaints/<%= complaint.id %>"
                  class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
                  title="View or update complaint"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15.232 5.232l3.536 3.536M4 20h4l10.732-10.732a2.5 2.5 0 00-3.536-3.536L4.464 16.464 4 20z"
                    />
                  </svg>
                  Manage
                </a>
              </td>
            </tr>
            <% }) %> <% if (complaints.length === 0) { %>
            <tr>
              <td colspan="7" class="px-4 py-12 text-center sm:px-6 sm:py-14">
                <div class="mx-auto max-w-sm">
                  <div
                    class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-slate-100 text-slate-400"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 10h8M8 14h5m7-2a8 8 0 11-16 0 8 8 0 0116 0z"
                      />
                    </svg>
                  </div>
                  <p class="mt-3 text-sm font-medium text-slate-700">
                    No complaints found.
                  </p>
                  <p class="mt-1 text-xs leading-5 text-slate-400">
                    Submitted student complaints will appear here.
                  </p>
                </div>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Scroll Hint -->
      <div
        class="border-t border-slate-100 bg-slate-50 px-4 py-2.5 text-xs text-slate-400 sm:hidden"
      >
        Swipe horizontally to view all table columns.
      </div>
    </div>
  </div>
</section>
