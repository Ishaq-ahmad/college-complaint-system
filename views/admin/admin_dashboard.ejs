<!-- Dashboard Content -->
<section class="min-h-screen bg-slate-50 px-5 py-7 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <!-- Page Heading -->
    <div class="mb-7">
      <p
        class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-blue-600"
      >
        Administration
      </p>

      <div
        class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
            All Complaints
          </h2>

          <p class="mt-1.5 text-sm text-slate-500">
            View and manage complaints submitted by students.
          </p>
        </div>
      </div>
    </div>

    <!-- Statistics -->
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <!-- Total Complaints -->
      <div
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Total Complaints</p>

            <h3
              class="mt-3 text-3xl font-semibold tracking-tight text-slate-900"
            >
              <%= total_complaints %>
            </h3>
          </div>

          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 10h8M8 14h5m7-2a8 8 0 11-16 0 8 8 0 0116 0z"
              />
            </svg>
          </div>
        </div>

        <div class="mt-5 h-1 w-10 rounded-full bg-blue-500"></div>
      </div>

      <!-- Pending -->
      <div
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Pending</p>

            <h3
              class="mt-3 text-3xl font-semibold tracking-tight text-amber-600"
            >
              <%= complaints.filter(item => item.status === 'Pending').length %>
            </h3>
          </div>

          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>

        <div class="mt-5 h-1 w-10 rounded-full bg-amber-400"></div>
      </div>

      <!-- Resolved -->
      <div
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Resolved</p>

            <h3
              class="mt-3 text-3xl font-semibold tracking-tight text-green-600"
            >
              <%= complaints.filter(item => item.status === 'Resolved').length
              %>
            </h3>
          </div>

          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-green-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>

        <div class="mt-5 h-1 w-10 rounded-full bg-green-400"></div>
      </div>

      <!-- Rejected -->
      <div
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Rejected</p>

            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-red-600">
              <%= complaints.filter(item => item.status === 'Rejected').length
              %>
            </h3>
          </div>

          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-red-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>

        <div class="mt-5 h-1 w-10 rounded-full bg-red-400"></div>
      </div>
    </div>

    <!-- Complaints Table -->
    <div
      class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Table Header -->
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <div>
          <h3 class="text-base font-semibold text-slate-900">
            Student Complaints
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Review submitted complaints and update their status.
          </p>
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full min-w-[950px] text-left text-sm">
          <!-- Table Heading -->
          <thead class="border-b border-slate-200 bg-slate-50/70">
            <tr class="text-xs uppercase tracking-wide text-slate-500">
              <th class="px-6 py-3.5 font-semibold">#</th>

              <th class="px-6 py-3.5 font-semibold">Title</th>

              <th class="px-6 py-3.5 font-semibold">Student</th>

              <th class="px-6 py-3.5 font-semibold">Category</th>

              <th class="px-6 py-3.5 font-semibold">Status</th>

              <th class="px-6 py-3.5 font-semibold">Date</th>

              <th class="px-6 py-3.5 text-right font-semibold">Action</th>
            </tr>
          </thead>

          <!-- Table Data -->
          <tbody class="divide-y divide-slate-100 text-slate-700">
            <% complaints.forEach((complaint, index) => { %>

            <tr class="transition hover:bg-slate-50/80">
              <!-- Number -->
              <td class="px-6 py-4 text-sm font-medium text-slate-400">
                <%= index + 1 %>
              </td>

              <!-- Title -->
              <td class="max-w-[250px] px-6 py-4">
                <p class="truncate font-medium text-slate-800">
                  <%= complaint.title.toUpperCase() %>
                </p>
              </td>

              <!-- Student -->
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600"
                  >
                    <%= complaint.student.name.toUpperCase().charAt(0) %>
                  </div>

                  <span class="whitespace-nowrap text-slate-700">
                    <%=
                    complaint.student.name.trim().toLowerCase().replace(/\b\w/g,
                    char => char.toUpperCase()) %>
                  </span>
                </div>
              </td>

              <!-- Category -->
              <td class="px-6 py-4 text-slate-500">
                <%= complaint.category %>
              </td>

              <!-- Status -->
              <td class="px-6 py-4">
                <span
                  class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= complaint.status === 'Pending' ? 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200' : complaint.status === 'Rejected' ? 'bg-red-200 text-red-700 ring-1 ring-inset ring-violet-200' : 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200' %>"
                >
                  <span class="h-1.5 w-1.5 rounded-full"></span>

                  <%= complaint.status %>
                </span>
              </td>

              <!-- Date -->
              <td class="whitespace-nowrap px-6 py-4 text-slate-500">
                <%= new Date(complaint.createdAt).toLocaleDateString("en-GB") %>
              </td>

              <!-- Action -->
              <td class="px-6 py-4 text-right">
                <a
                  href="/admin/complaints/<%= complaint.id %>"
                  class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
                  title="View or update complaint"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15.232 5.232l3.536 3.536M4 20h4l10.732-10.732a2.5 2.5 0 00-3.536-3.536L4.464 16.464 4 20z"
                    />
                  </svg>

                  Manage
                </a>
              </td>
            </tr>

            <% }) %> <% if (complaints.length === 0) { %>

            <tr>
              <td colspan="7" class="px-6 py-14 text-center">
                <div class="mx-auto max-w-sm">
                  <div
                    class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-slate-100 text-slate-400"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 10h8M8 14h5m7-2a8 8 0 11-16 0 8 8 0 0116 0z"
                      />
                    </svg>
                  </div>

                  <p class="mt-3 text-sm font-medium text-slate-700">
                    No complaints found.
                  </p>

                  <p class="mt-1 text-xs text-slate-400">
                    Submitted student complaints will appear here.
                  </p>
                </div>
              </td>
            </tr>

            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
