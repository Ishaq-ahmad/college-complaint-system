```ejs
<div class="min-h-screen bg-slate-50 px-3 py-5 sm:px-6 sm:py-8 lg:px-8">
  <div class="mx-auto w-full max-w-6xl">

    <!-- Top Navigation -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 sm:mb-8">
      <a
        href="/admin/complaints"
        class="group inline-flex min-w-0 items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-blue-700"
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 transition group-hover:border-blue-200 group-hover:text-blue-700"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </span>
        <span>Back to All Complaints</span>
      </a>

      <span
        class="hidden rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-500 sm:inline-flex"
      >
        Complaint Details
      </span>
    </div>

    <!-- Page Header -->
    <div class="mb-6 border-b border-slate-200 pb-6 sm:mb-8">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-blue-700">
        Complaint Management
      </p>

      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">
        Complaint Details
      </h1>

      <div class="mt-4 flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-3">
        <span class="text-sm text-slate-500">Submitted by</span>

        <span class="inline-flex max-w-full items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-800 shadow-sm">
          <span class="mr-2 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-50 text-xs font-bold text-blue-700">
            <%= complaint.student.name.charAt(0).toUpperCase() %>
          </span>
          <span class="break-words">
            <%= complaint.student.name.charAt(0).toUpperCase() + complaint.student.name.slice(1).toLowerCase() %>
          </span>
        </span>
      </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 items-start gap-5 sm:gap-6 lg:grid-cols-3">

      <!-- Complaint Information -->
      <div class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm lg:col-span-2">

        <!-- Card Header -->
        <div class="border-b border-slate-100 px-4 py-5 sm:px-6 lg:px-8">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            Complaint Information
          </p>

          <h2 class="mt-1 text-lg font-semibold text-slate-800 sm:text-xl">
            Submitted Complaint
          </h2>
        </div>

        <div class="px-4 sm:px-6 lg:px-8">

          <!-- Title -->
          <div class="grid gap-2 border-b border-slate-100 py-5 sm:grid-cols-4 sm:gap-4 sm:py-6 lg:gap-6">
            <p class="text-sm font-medium text-slate-500">
              Title
            </p>

            <p class="min-w-0 break-words text-sm font-medium leading-6 text-slate-800 sm:col-span-3">
              <%= complaint.title %>
            </p>
          </div>

          <!-- Category -->
          <div class="grid gap-2 border-b border-slate-100 py-5 sm:grid-cols-4 sm:gap-4 sm:py-6 lg:gap-6">
            <p class="text-sm font-medium text-slate-500">
              Category
            </p>

            <div class="sm:col-span-3">
              <span class="inline-flex max-w-full break-words rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-700">
                <%= complaint.category %>
              </span>
            </div>
          </div>

          <!-- Description -->
          <div class="grid gap-2 border-b border-slate-100 py-5 sm:grid-cols-4 sm:gap-4 sm:py-6 lg:gap-6">
            <p class="text-sm font-medium text-slate-500">
              Description
            </p>

            <p class="min-w-0 whitespace-pre-line break-words text-sm leading-7 text-slate-600 sm:col-span-3">
              <%= complaint.description %>
            </p>
          </div>

          <!-- Status -->
          <div class="grid gap-3 border-b border-slate-100 py-5 sm:grid-cols-4 sm:gap-4 sm:py-6 lg:gap-6">
            <p class="text-sm font-medium text-slate-500">
              Status
            </p>

            <div class="sm:col-span-3">
              <span
                class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold
                <%= complaint.status === 'Pending'
                  ? 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200'
                  : complaint.status === 'Rejected'
                  ? 'bg-red-50 text-red-700 ring-1 ring-inset ring-red-200'
                  : 'bg-green-50 text-green-700 ring-1 ring-inset ring-green-200' %>"
              >
                <span class="mr-2 h-1.5 w-1.5 shrink-0 rounded-full bg-current"></span>
                <%= complaint.status %>
              </span>
            </div>
          </div>

          <!-- Date -->
          <div class="grid gap-2 py-5 sm:grid-cols-4 sm:gap-4 sm:py-6 lg:gap-6">
            <p class="text-sm font-medium text-slate-500">
              Date
            </p>

            <p class="text-sm text-slate-600 sm:col-span-3">
              <%= new Date(complaint.createdAt).toLocaleDateString("en-GB") %>
            </p>
          </div>

        </div>
      </div>

      <!-- Update Status -->
      <div class="h-fit min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <!-- Card Header -->
        <div class="border-b border-slate-100 px-4 py-5 sm:px-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            Administration
          </p>

          <h2 class="mt-1 text-lg font-semibold text-slate-800">
            Update Status
          </h2>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Change the current status of this complaint.
          </p>
        </div>

        <!-- Form -->
        <div class="p-4 sm:p-6">
          <form action="/admin/complaints/<%=complaint.id%>" method="POST">

            <label
              for="status"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Select Status
            </label>

            <select
              id="status"
              name="status"
              class="mb-5 min-h-12 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
            >
              <option value="Pending" <%= complaint.status === "Pending" ? "selected" : "" %>>
                Pending
              </option>

              <option value="Resolved" <%= complaint.status === "Resolved" ? "selected" : "" %>>
                Resolved
              </option>

              <option value="Rejected" <%= complaint.status === "Rejected" ? "selected" : "" %>>
                Rejected
              </option>
            </select>

            <button
              type="submit"
              class="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100 active:scale-[0.99]"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Update Status
            </button>
          </form>
        </div>

      </div>
    </div>

    <!-- Bottom Note -->
    <div class="mt-5 flex items-start gap-3 rounded-xl border border-slate-200 bg-white px-4 py-4 sm:mt-6 sm:px-5">
      <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-50 text-sm font-semibold text-blue-700">
        i
      </div>

      <p class="min-w-0 text-xs leading-5 text-slate-500 sm:text-sm">
        Review the complaint information carefully before changing its status.
      </p>
    </div>

  </div>
</div>
```