<!-- Main Content -->
<section class="min-h-screen bg-slate-50 px-5 py-7 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <!-- Page Heading -->
    <div class="mb-7">
      <p
        class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-blue-600"
      >
        Administration
      </p>

      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
        <%= title %>
      </h2>

      <p class="mt-1.5 text-sm text-slate-500">
        Track and manage complaints submitted by students.
      </p>
    </div>

    <!-- Complaints Table -->
    <div
      class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Table Header -->
      <div
        class="flex flex-col gap-2 border-b border-slate-200 px-5 py-5 sm:px-6"
      >
        <h3 class="text-base font-semibold text-slate-900">
          Complaint Records
        </h3>

        <p class="text-sm text-slate-500">
          Review submitted complaints and open a complaint to manage its status.
        </p>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full min-w-[950px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50/70">
            <tr class="text-xs uppercase tracking-wide text-slate-500">
              <th class="px-6 py-3.5 font-semibold">#</th>

              <th class="px-6 py-3.5 font-semibold">Student</th>

              <th class="px-6 py-3.5 font-semibold">Title</th>

              <th class="px-6 py-3.5 font-semibold">Category</th>

              <th class="px-6 py-3.5 font-semibold">Status</th>

              <th class="px-6 py-3.5 font-semibold">Date</th>

              <th class="px-6 py-3.5 text-right font-semibold">Action</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 text-slate-700">
            <!-- Complaint 1 -->

            <% complaints.forEach((compl, idx) => { %>

            <tr class="transition hover:bg-slate-50/80">
              <!-- Number -->
              <td class="px-6 py-4 text-sm font-medium text-slate-400">
                <%= idx + 1 %>
              </td>

              <!-- Student -->
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600"
                  >
                    <%= compl.student.name.charAt(0).toUpperCase() %>
                  </div>

                  <span class="whitespace-nowrap font-medium text-slate-700">
                    <%= compl.student.name.charAt(0).toUpperCase() +
                    compl.student.name.slice(1).toLowerCase() %>
                  </span>
                </div>
              </td>

              <!-- Title -->
              <td class="max-w-[260px] px-6 py-4">
                <p class="truncate font-medium text-slate-800">
                  <%= compl.title %>
                </p>
              </td>

              <!-- Category -->
              <td class="px-6 py-4 text-slate-500"><%= compl.category %></td>

              <!-- Status -->
              <td class="px-6 py-4">
                <span
                  class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200 <%= compl.status === 'Pending' ? 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200' : compl.status === 'Resolved' ? 'bg-green-200 text-green-700 ring-1 ring-inset ring-emerald-200' : compl.status === 'Rejected' ? 'bg-red-200 text-red-700 ring-1 ring-inset ring-red-200' : 'bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-200' %>"
                >
                  <span
                    class="h-1.5 w-1.5 rounded-full bg-amber-500 <%= compl.status === 'Pending' ? 'bg-amber-500' : compl.status === 'Resolved' ? 'bg-green-500' : compl.status === 'Rejected' ? 'bg-red-500' : 'bg-slate-500' %>"
                  >
                  </span>
                  <%= compl.status %>
                </span>
              </td>

              <!-- Date -->
              <td class="whitespace-nowrap px-6 py-4 text-slate-500">
                <%= new Date(compl.createdAt).toLocaleDateString("en-GB") %>
              </td>

              <!-- Action -->
              <td class="px-6 py-4 text-right">
                <a
                  href="/admin/complaints/<%= compl.id %>"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
                >
                  View

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </td>
            </tr>

            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
