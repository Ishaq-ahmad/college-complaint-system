<!-- Main Content -->
<div class="min-h-screen bg-slate-50 px-3 py-5 sm:px-6 sm:py-7 lg:px-8">
  <div class="mx-auto w-full max-w-7xl min-w-0">
    <!-- Page Header -->
    <div
      class="mb-6 flex flex-col gap-4 sm:mb-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
          Administration
        </p>

        <h1
          class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
        >
          All Users
        </h1>

        <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">
          Manage and view all registered accounts in your college portal.
        </p>
      </div>

      <!-- Total Accounts -->
      <div
        class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm sm:w-auto sm:min-w-[180px]"
      >
        <div
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="10" cy="7" r="4" />
            <path d="M20 8v6" />
            <path d="M23 11h-6" />
          </svg>
        </div>
        <div>
          <p class="text-xs text-slate-500">Total Accounts</p>
          <p class="text-xl font-bold text-slate-900"><%= users.length %></p>
        </div>
      </div>
    </div>

    <!-- Statistics -->
    <div
      class="mb-6 grid grid-cols-1 gap-3 sm:mb-8 sm:grid-cols-2 sm:gap-4 xl:grid-cols-3"
    >
      <!-- All Users -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-500">All Users</p>
          <span class="rounded-lg bg-blue-50 p-2 text-blue-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="10" cy="7" r="4" />
              <path d="M20 8v6" />
              <path d="M23 11h-6" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">
          <%= users.length %>
        </p>
        <p class="mt-1 text-xs text-slate-400">Registered accounts</p>
      </div>

      <!-- Students -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-500">Students</p>
          <span class="rounded-lg bg-emerald-50 p-2 text-emerald-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m22 10-10-5L2 10l10 5 10-5Z" />
              <path d="M6 12v5c3.5 3 8.5 3 12 0v-5" />
              <path d="M22 10v6" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">
          <%= users.filter(u => u.role === "student").length %>
        </p>
        <p class="mt-1 text-xs text-slate-400">Student accounts</p>
      </div>

      <!-- Administrators -->
      <div
        class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-5"
      >
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-500">Administrators</p>
          <span class="rounded-lg bg-violet-50 p-2 text-violet-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">
          <%= users.filter(u => u.role === "admin").length %>
        </p>
        <p class="mt-1 text-xs text-slate-400">Admin accounts</p>
      </div>
    </div>

    <!-- Users Table -->
    <div
      class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Table Toolbar -->
      <div
        class="flex flex-col gap-4 border-b border-slate-200 p-4 sm:p-5 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="min-w-0">
          <h2 class="text-base font-semibold text-slate-900">
            Registered Users
          </h2>
          <p class="mt-1 text-sm text-slate-500">
            Account directory and role information
          </p>
        </div>

        <!-- Search -->
        <div class="relative w-full lg:max-w-sm">
          <svg
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>

          <input
            id="userSearch"
            type="text"
            placeholder="Search name, email or role..."
            class="w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-10 pr-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
          />
        </div>
      </div>

      <!-- Responsive Table -->
      <div class="w-full overflow-x-auto">
        <table class="w-full min-w-[680px] text-left">
          <thead class="bg-slate-50">
            <tr class="border-b border-slate-200">
              <th
                class="whitespace-nowrap px-4 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-5"
              >
                User
              </th>
              <th
                class="whitespace-nowrap px-4 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-5"
              >
                Email Address
              </th>
              <th
                class="whitespace-nowrap px-4 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-5"
              >
                Role
              </th>
              <th
                class="whitespace-nowrap px-4 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-5"
              >
                Joined Date
              </th>
            </tr>
          </thead>

          <tbody id="usersTable" class="divide-y divide-slate-100">
            <% users.forEach((item) => { %>
            <tr class="user-row transition-colors hover:bg-slate-50/80">
              <!-- User Name + Initials -->
              <td class="whitespace-nowrap px-4 py-4 sm:px-5">
                <div class="flex items-center gap-3">
                  <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full <%= item.role === 'admin' ? 'bg-violet-100 text-violet-700' : 'bg-blue-100 text-blue-700' %> text-sm font-bold"
                  >
                    <%= item.name .trim() .split(/\s+/) .map(word =>
                    word[0].toUpperCase()) .slice(0, 2) .join('') %>
                  </div>

                  <div class="min-w-0">
                    <p class="user-name text-sm font-semibold text-slate-900">
                      <%= item.name %>
                    </p>
                    <p class="mt-1 text-xs text-slate-400">
                      User ID: <%= item._id %>
                    </p>
                  </div>
                </div>
              </td>

              <!-- Email -->
              <td class="whitespace-nowrap px-4 py-4 sm:px-5">
                <span class="user-email text-sm text-slate-600">
                  <%= item.email %>
                </span>
              </td>

              <!-- Role Badge -->
              <td class="whitespace-nowrap px-4 py-4 sm:px-5">
                <% if (item.role === "admin") { %>
                <span
                  class="user-role inline-flex items-center gap-1.5 rounded-full bg-violet-50 px-3 py-1.5 text-xs font-semibold text-violet-700"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-violet-500"></span>
                  Admin
                </span>
                <% } else { %>
                <span
                  class="user-role inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Student
                </span>
                <% } %>
              </td>

              <!-- Registration Date -->
              <td
                class="whitespace-nowrap px-4 py-4 text-sm text-slate-500 sm:px-5"
              >
                <%= item.createdAt ? new
                Date(item.createdAt).toLocaleDateString("en-GB", { day:
                "2-digit", month: "short", year: "numeric" }) : "—" %>
              </td>
            </tr>
            <% }) %>

            <tr id="noUsersFound" class="hidden">
              <td colspan="4" class="px-4 py-12 text-center sm:px-6">
                <p class="font-semibold text-slate-700">No users found</p>
                <p class="mt-1 text-sm text-slate-500">
                  Try searching with another name or email.
                </p>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile Scroll Hint -->
      <div
        class="border-t border-slate-100 bg-slate-50 px-4 py-2.5 text-xs text-slate-400 sm:hidden"
      >
        Swipe horizontally to view all user details.
      </div>

      <!-- Footer -->
      <div
        class="flex flex-col gap-2 border-t border-slate-200 bg-slate-50/60 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p class="text-xs text-slate-500">
          Showing <span id="visibleCount"><%= users.length %></span> of <%=
          users.length %> accounts
        </p>
        <p class="text-xs text-slate-400">College CMS · User Directory</p>
      </div>
    </div>
  </div>
</div>

<!-- Search Functionality -->
<script>
  const userSearch = document.getElementById("userSearch");
  const userRows = document.querySelectorAll(".user-row");
  const visibleCount = document.getElementById("visibleCount");
  const noUsersFound = document.getElementById("noUsersFound");

  userSearch.addEventListener("input", function () {
    const searchValue = this.value.toLowerCase().trim();
    let count = 0;

    userRows.forEach((row) => {
      const matches = row.textContent.toLowerCase().includes(searchValue);
      row.classList.toggle("hidden", !matches);

      if (matches) count++;
    });

    visibleCount.textContent = count;
    noUsersFound.classList.toggle("hidden", count !== 0);
  });
</script>
