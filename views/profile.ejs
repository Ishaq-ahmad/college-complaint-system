<div class="min-h-screen bg-slate-50 p-6 md:p-10">
  <div class="mx-auto max-w-5xl">
    <!-- Page Header -->
    <div class="mb-8">
      <p class="text-sm font-medium text-blue-600">Account</p>

      <div
        class="mt-1 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
      >
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-800">
            <%= title %>
          </h1>

          <p class="mt-1 text-sm text-slate-500">
            Manage your account information and view your profile details.
          </p>
        </div>

        <a
          href="/dashboard"
          class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
        >
          ← Back to Dashboard
        </a>
      </div>
    </div>

    <!-- Profile Card -->
    <div
      class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Top Section -->
      <div class="border-b border-slate-100 px-6 py-7 md:px-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
          <!-- Avatar -->
          <div
            class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-blue-600 text-2xl font-bold text-white ring-8 ring-blue-50"
          >
            <%= user.name .trim() .split(/\s+/) .map(word =>
            word[0].toUpperCase()) .slice(0, 2) .join('') %>
          </div>

          <!-- User Info -->
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-2xl font-bold text-slate-800">
                <%= user.name.trim() .toLowerCase() .replace(/\b\w/g, char =>
                char.toUpperCase()) %>!
              </h2>

              <span
                class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700"
              >
                <%= user.role %>
              </span>
            </div>

            <p class="mt-1 text-sm text-slate-500"><%= user.email %></p>
          </div>
        </div>
      </div>

      <!-- Account Information -->
      <div class="px-6 py-7 md:px-8">
        <div class="mb-5">
          <h3 class="text-lg font-semibold text-slate-800">
            Account Information
          </h3>

          <p class="mt-1 text-sm text-slate-500">Your basic account details.</p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <!-- Full Name -->
          <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-5">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-400"
            >
              Full Name
            </p>

            <p class="mt-2 text-sm font-semibold text-slate-800">
              <%= user.name.trim().toLowerCase().replace(/\b\w/g, char =>
              char.toUpperCase()) %>
            </p>
          </div>

          <!-- Email -->
          <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-5">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-400"
            >
              Email Address
            </p>

            <p class="mt-2 break-all text-sm font-semibold text-slate-800">
              <%= user.email %>
            </p>
          </div>

          <!-- Role -->
          <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-5">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-400"
            >
              Account Type
            </p>

            <p class="mt-2 text-sm font-semibold text-slate-800">
              <%= user.role.trim().toLowerCase().replace(/\b\w/g, char =>
              char.toUpperCase()) %>
            </p>
          </div>

          <!-- Account Status -->
          <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-5">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-400"
            >
              Account Status
            </p>

            <div class="mt-2 flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>

              <span class="text-sm font-semibold text-slate-800"> Active </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Account Activity -->
      <div class="border-t border-slate-100 px-6 py-7 md:px-8">
        <div class="mb-5">
          <h3 class="text-lg font-semibold text-slate-800">Account Activity</h3>

          <p class="mt-1 text-sm text-slate-500">
            A quick overview of your complaint activity.
          </p>
        </div>

        <!-- ========  For Admin ====== -->
        <% if (user.role === 'admin') { %>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Total -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Total Complaints</p>

            <p class="mt-2 text-2xl font-bold text-slate-800">
              <%= totalAdminComplaints %>
            </p>
          </div>

          <!-- Pending -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Pending</p>

            <p class="mt-2 text-2xl font-bold text-amber-600">
              <%= adminComplaints.filter(item => item.status ===
              'Pending').length %>
            </p>
          </div>

          <!-- Resolved -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Resolved</p>

            <p class="mt-2 text-2xl font-bold text-emerald-600">
              <%= adminComplaints.filter(item => item.status ===
              'Resolved').length %>
            </p>
          </div>

          <!-- Rejected -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Rejected</p>

            <p class="mt-2 text-2xl font-bold text-red-600">
              <%= adminComplaints.filter(item => item.status ===
              'Rejected').length %>
            </p>
          </div>
        </div>

        <% } else { %>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Total -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Total Complaints</p>

            <p class="mt-2 text-2xl font-bold text-slate-800">
              <%= totalComplaints %>
            </p>
          </div>

          <!-- Pending -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Pending</p>

            <p class="mt-2 text-2xl font-bold text-amber-600">
              <%= complaints.filter(item => item.status === 'Pending').length %>
            </p>
          </div>

          <!-- Resolved -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Resolved</p>

            <p class="mt-2 text-2xl font-bold text-emerald-600">
              <%= complaints.filter(item => item.status === 'Resolved').length
              %>
            </p>
          </div>

          <!-- Rejected -->
          <div class="rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500">Rejected</p>

            <p class="mt-2 text-2xl font-bold text-red-600">
              <%= complaints.filter(item => item.status === 'Rejected').length
              %>
            </p>
          </div>
        </div>

        <% } %>
      </div>

      <!-- Footer Actions -->
      <div
        class="flex flex-col gap-3 border-t border-slate-100 bg-slate-50/70 px-6 py-5 sm:flex-row sm:justify-between md:px-8"
      >
        <p class="self-center text-xs text-slate-400">
          Need to update your account details?
        </p>

        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href="/dashboard"
            class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            Dashboard
          </a>

          <a
            href="/logout"
            class="rounded-lg bg-slate-800 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-slate-900"
          >
            Logout
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
