<div class="min-h-screen bg-slate-50 px-3 py-5 sm:px-6 sm:py-8 lg:px-8">
  <div class="mx-auto w-full max-w-5xl">
    <!-- Page Header -->
    <div class="mb-6 sm:mb-8">
      <p class="text-sm font-semibold text-blue-600">Account</p>

      <div
        class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div class="min-w-0">
          <h1
            class="text-2xl font-bold tracking-tight text-slate-800 sm:text-3xl"
          >
            <%= title %>
          </h1>

          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
            Manage your account information and view your profile details.
          </p>
        </div>

        <% if (user.role === 'admin') { %>
        <a
          href="/admin/dashboard"
          class="inline-flex min-h-11 w-full shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 sm:w-auto"
        >
          <span aria-hidden="true">←</span>
          Back to Dashboard
        </a>
        <% } %> <% if (user.role === 'student') { %>
        <a
          href="/dashboard"
          class="inline-flex min-h-11 w-full shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 sm:w-auto"
        >
          <span aria-hidden="true">←</span>
          Back to Dashboard
        </a>
        <% } %>
      </div>
    </div>

    <!-- Profile Card -->
    <div
      class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >
      <!-- Profile Header -->
      <div class="border-b border-slate-100 px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <div
          class="flex min-w-0 flex-col gap-5 sm:flex-row sm:items-center sm:gap-6"
        >
          <!-- Avatar -->
          <div
            class="flex h-20 w-20 shrink-0 items-center justify-center self-start rounded-2xl bg-blue-600 text-2xl font-bold text-white ring-4 ring-blue-50 sm:h-24 sm:w-24 sm:rounded-3xl sm:text-3xl"
          >
            <%= user.name .trim() .split(/\s+/) .map(word =>
            word[0].toUpperCase()) .slice(0, 2) .join('') %>
          </div>

          <!-- User Info -->
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
              <h2
                class="break-words text-xl font-bold leading-tight text-slate-800 sm:text-2xl"
              >
                <%= user.name.trim() .toLowerCase() .replace(/\b\w/g, char =>
                char.toUpperCase()) %>!
              </h2>

              <span
                class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold capitalize text-blue-700 ring-1 ring-inset ring-blue-100"
              >
                <%= user.role %>
              </span>
            </div>

            <p
              class="mt-2 break-all text-sm leading-6 text-slate-500 sm:break-words"
            >
              <%= user.email %>
            </p>

            <div
              class="mt-4 inline-flex items-center gap-2 rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700"
            >
              <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500"></span>
              Account Active
            </div>
          </div>
        </div>
      </div>

      <!-- Account Information -->
      <div class="px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <div class="mb-5">
          <h3 class="text-base font-bold text-slate-800 sm:text-lg">
            Account Information
          </h3>

          <p class="mt-1 text-sm leading-5 text-slate-500">
            Your basic account details.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
          <!-- Full Name -->
          <div
            class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition hover:border-slate-300 sm:p-5"
          >
            <div class="flex items-start gap-3">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M20 21a8 8 0 00-16 0m8-10a4 4 0 100-8 4 4 0 000 8z"
                  />
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <p
                  class="text-xs font-semibold uppercase tracking-wide text-slate-400"
                >
                  Full Name
                </p>

                <p
                  class="mt-2 break-words text-sm font-semibold leading-6 text-slate-800"
                >
                  <%= user.name.trim().toLowerCase().replace(/\b\w/g, char =>
                  char.toUpperCase()) %>
                </p>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div
            class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition hover:border-slate-300 sm:p-5"
          >
            <div class="flex items-start gap-3">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M3 7l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <p
                  class="text-xs font-semibold uppercase tracking-wide text-slate-400"
                >
                  Email Address
                </p>

                <p
                  class="mt-2 break-all text-sm font-semibold leading-6 text-slate-800"
                >
                  <%= user.email %>
                </p>
              </div>
            </div>
          </div>

          <!-- Role -->
          <div
            class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition hover:border-slate-300 sm:p-5"
          >
            <div class="flex items-start gap-3">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M12 15l3.5 2-1-4 3-2.5-4-.3L12 6.5l-1.5 3.7-4 .3 3 2.5-1 4L12 15z"
                  />
                  <circle cx="12" cy="12" r="9" stroke-width="1.8" />
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <p
                  class="text-xs font-semibold uppercase tracking-wide text-slate-400"
                >
                  Account Type
                </p>

                <p
                  class="mt-2 break-words text-sm font-semibold leading-6 text-slate-800"
                >
                  <%= user.role.trim().toLowerCase().replace(/\b\w/g, char =>
                  char.toUpperCase()) %>
                </p>
              </div>
            </div>
          </div>

          <!-- Account Status -->
          <div
            class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition hover:border-slate-300 sm:p-5"
          >
            <div class="flex items-start gap-3">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M5 12l4 4L19 6"
                  />
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <p
                  class="text-xs font-semibold uppercase tracking-wide text-slate-400"
                >
                  Account Status
                </p>

                <div class="mt-2 flex items-center gap-2">
                  <span
                    class="h-2 w-2 shrink-0 rounded-full bg-emerald-500"
                  ></span>
                  <span class="text-sm font-semibold text-slate-800">
                    Active
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Account Activity -->
      <div class="border-t border-slate-100 px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <div class="mb-5">
          <h3 class="text-base font-bold text-slate-800 sm:text-lg">
            Account Activity
          </h3>

          <p class="mt-1 text-sm leading-5 text-slate-500">
            A quick overview of your complaint activity.
          </p>
        </div>

        <!-- ======== For Admin ====== -->
        <% if (user.role === 'admin') { %>

        <div
          class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4"
        >
          <!-- Total -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Total Complaints</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-slate-800">
              <%= totalAdminComplaints %>
            </p>
          </div>

          <!-- Pending -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Pending</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    stroke-width="1.8"
                    fill="none"
                    stroke="currentColor"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M12 7v5l3 2"
                    fill="none"
                    stroke="currentColor"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-amber-600">
              <%= adminComplaints.filter(item => item.status ===
              'Pending').length %>
            </p>
          </div>

          <!-- Resolved -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Resolved</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M5 12l4 4L19 6"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-emerald-600">
              <%= adminComplaints.filter(item => item.status ===
              'Resolved').length %>
            </p>
          </div>

          <!-- Rejected -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Rejected</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M6 6l12 12M18 6L6 18"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-red-600">
              <%= adminComplaints.filter(item => item.status ===
              'Rejected').length %>
            </p>
          </div>
        </div>

        <% } else { %>

        <div
          class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4"
        >
          <!-- Total -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Total Complaints</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-slate-800">
              <%= totalComplaints %>
            </p>
          </div>

          <!-- Pending -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Pending</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    stroke-width="1.8"
                    fill="none"
                    stroke="currentColor"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M12 7v5l3 2"
                    fill="none"
                    stroke="currentColor"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-amber-600">
              <%= complaints.filter(item => item.status === 'Pending').length %>
            </p>
          </div>

          <!-- Resolved -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Resolved</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M5 12l4 4L19 6"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-emerald-600">
              <%= complaints.filter(item => item.status === 'Resolved').length
              %>
            </p>
          </div>

          <!-- Rejected -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-slate-500">Rejected</p>
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-700"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M6 6l12 12M18 6L6 18"
                  />
                </svg>
              </span>
            </div>
            <p class="mt-4 text-2xl font-bold tabular-nums text-red-600">
              <%= complaints.filter(item => item.status === 'Rejected').length
              %>
            </p>
          </div>
        </div>

        <% } %>
      </div>

      <!-- Footer Actions -->
      <div
        class="flex flex-col gap-4 border-t border-slate-100 bg-slate-50/70 px-4 py-5 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"
      >
        <p class="text-xs leading-5 text-slate-500 sm:text-sm">
          Need to update your account details?
        </p>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:flex md:shrink-0">
          <a
            href="/dashboard"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100"
          >
            Dashboard
          </a>

          <a
            href="/logout"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"
          >
            Logout
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
